# Segreto HMAC del cookie di sblocco lead. Obbligatorio, almeno 16 caratteri (meglio 32+ casuali).
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LEAD_COOKIE_SECRET=

# Email dei lead tramite Resend. Senza queste chiavi il modulo risponde 503.
RESEND_API_KEY=
LEADS_TO_EMAIL=
LEADS_FROM_EMAIL=

# Foglio Google dei lead (opzionale). Se manca anche una sola delle tre variabili
# obbligatorie, la scrittura si salta e il simulatore si sblocca dopo l'email.
# Se sono impostate ma la scrittura fallisce, l'errore finisce nei log e lo
# sblocco avviene comunque. Non committare il JSON del service account.
#
# Setup:
# 1. Crea un progetto su https://console.cloud.google.com/
# 2. API e servizi → Libreria → abilita Google Sheets API.
# 3. IAM e amministrazione → Account di servizio → crea un account, poi
#    Chiavi → Aggiungi chiave → JSON. Scarica il file e non committarlo.
# 4. Crea un foglio Google privato. Rinomina il primo tab in Lead
#    (oppure scegli un nome e mettilo in GOOGLE_SHEETS_TAB_NAME).
# 5. Condividi il foglio come Editor con client_email del JSON
#    (finisce con .iam.gserviceaccount.com).
# 6. L'ID è la parte di URL tra /d/ e /edit:
#    https://docs.google.com/spreadsheets/d/QUESTO_E_L_ID/edit
# 7. Su Vercel imposta le tre variabili qui sotto e fai un nuovo deploy.
#    In GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY incolla private_key così com'è,
#    con i \n letterali: il server li converte in ritorni a capo.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# GOOGLE_SHEETS_TAB_NAME=Lead

# URL canonico (metadata, sitemap, Open Graph). Default: https://costilavoroitalia.it
# NEXT_PUBLIC_SITE_URL=https://costilavoroitalia.it

# Opzionale: informativa privacy esterna. Se vuoto si usa /privacy.
# NEXT_PUBLIC_PRIVACY_URL=

# Rate limit condiviso tra le istanze Vercel. Senza queste chiavi il limite
# resta nella memoria del processo.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

NEXT_PUBLIC_APP_NAME=Costi Lavoro Italia
