# Segreto HMAC del cookie di sblocco lead. Obbligatorio, almeno 16 caratteri (meglio 32+ casuali).
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LEAD_COOKIE_SECRET=

# Email dei lead tramite SMTP. Servono tutte: senza una di queste il modulo
# risponde 503 e non sblocca il simulatore. Nessuna mail viene inviata al visitatore.
# Esempio Hostinger (la password della casella non va mai committata):
#   host smtp.hostinger.com
#   porta 465 con SSL implicito; se non funziona, 587 con STARTTLS
#   utente SMTP_USER = indirizzo completo della casella (info@costilavoroitalia.it)
#   LEADS_TO_EMAIL = info@costilavoroitalia.it (la notifica arriva al titolare)
#   LEADS_FROM_EMAIL = info@costilavoroitalia.it
#     oppure: Costi Lavoro Italia <info@costilavoroitalia.it>
#   SMTP_PASS = password della casella, solo nel pannello, mai nel repository
# Su Hostinger queste variabili si impostano nel pannello della Web App prima del deploy.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
LEADS_TO_EMAIL=
LEADS_FROM_EMAIL=

# URL canonico (metadata, sitemap, Open Graph). Default: https://costilavoroitalia.it
# NEXT_PUBLIC_SITE_URL=https://costilavoroitalia.it

# Opzionale: informativa privacy esterna. Se vuoto si usa /privacy.
# NEXT_PUBLIC_PRIVACY_URL=

# Rate limit condiviso tra le istanze Vercel. Senza queste chiavi il limite
# resta nella memoria del processo.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

NEXT_PUBLIC_APP_NAME=Costi Lavoro Italia
