# Login area consulente (cookie di sessione httpOnly, 7 giorni).
AUTH_EMAIL=
AUTH_PASSWORD=

# Segreto HMAC della sessione admin. Obbligatorio, almeno 16 caratteri (meglio 32+ casuali).
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET=

# Opzionale. Incrementa il valore (es. da 1 a 2) per revocare tutte le sessioni admin.
# AUTH_SESSION_VERSION=1

# Segreto HMAC del cookie di sblocco lead. Obbligatorio, almeno 16 caratteri (meglio 32+ casuali).
LEAD_COOKIE_SECRET=

# Email dei lead tramite Resend. Senza queste chiavi il modulo risponde 503.
RESEND_API_KEY=
LEADS_TO_EMAIL=
LEADS_FROM_EMAIL=

# URL canonico (metadata, sitemap, Open Graph). Default: https://costworkpro.vercel.app
# NEXT_PUBLIC_SITE_URL=https://costworkpro.vercel.app

# Opzionale: informativa privacy esterna. Se vuoto si usa /privacy.
# NEXT_PUBLIC_PRIVACY_URL=

# Rate limit condiviso e revoca della singola sessione admin (logout).
# Senza queste chiavi il limite resta nella memoria dell'istanza (più debole su Vercel)
# e la revoca delle sessioni avviene solo alzando AUTH_SESSION_VERSION.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

NEXT_PUBLIC_APP_NAME=Calcolatore Costo Lavoro
